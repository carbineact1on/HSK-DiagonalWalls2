<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="DiagonalWallBase" Name="DiagonalEmbrasureBase" Abstract="True">
    <statBases>
      <MaxHitPoints>480</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
    </statBases>
    <costStuffCount>8</costStuffCount>
    <costList>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <stuffCategories Inherit="False">
      <li>Woody</li>
      <li>Stony</li>
      <li>Bricks</li>
    </stuffCategories>
    <blockWind>false</blockWind>
    <fillPercent>0.7</fillPercent>
    <blockLight>false</blockLight>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
</ThingDef>

<ThingDef ParentName="DiagonalEmbrasureBase">
  <defName>rgh_DiagonalEmbrasure</defName>
  <description>A diagonal wall with a firing port. Use for walls that are 1-tile thick.</description>
  <label>dia. embrasure (thin)</label>
  <graphicData>
    <texPath>DiagonalRim/Walls/Embrasures/DiagonalWall</texPath>
  </graphicData>
  <building>
    <blueprintGraphicData>
      <texPath>DiagonalRim/Walls/Embrasures/DiagonalWall/Blueprint</texPath>
    </blueprintGraphicData>
  </building>
  <uiIconPath>DiagonalRim/Walls/Embrasures/DiagonalWall/MenuIcon</uiIconPath>
    <uiIconPathsStuff>
      <li>
        <appearance>Planks</appearance>
        <iconPath>DiagonalRim/Walls/Embrasures/DiagonalWall/MenuIcon</iconPath>
      </li>
      <li>
        <appearance>Bricks</appearance>
        <iconPath>DiagonalRim/Walls/Embrasures/DiagonalWall/MenuIcon</iconPath>
      </li>
    </uiIconPathsStuff>
</ThingDef>

