<?xml version="1.0" encoding="utf-8"?>
<!-- Force diagonalConduit costList to Wire 1 -->
<Patch>
    <Operation Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
            <!-- If a costList already exists (future-proof), wipe it first -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="diagonalConduit"]/costList</xpath>
            </li>
        </operations>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="diagonalConduit"]</xpath>
        <value>
<!-- Inherit="False" is critical: <costList> is a List<ThingDefCountClass> -->
            <costList Inherit="False">
                <Wire>1</Wire>
            </costList>
        </value>
    </Operation>
</Patch>
