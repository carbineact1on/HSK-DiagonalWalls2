        <texPath>DiagonalRim/Walls/Standard/DiagonalWall/Blueprint</texPath>
      </blueprintGraphicData>
    </building>
    <uiIconPath>DiagonalRim/Walls/Standard/DiagonalWall/MenuIcon</uiIconPath>
    <uiIconPathsStuff>
      <li>
        <appearance>Planks</appearance>
        <iconPath>DiagonalRim/Walls/Standard/DiagonalWall/MenuIcon</iconPath>
      </li>
      <li>
        <appearance>Bricks</appearance>
        <iconPath>DiagonalRim/Walls/Standard/DiagonalWall/MenuIcon</iconPath>
      </li>
    </uiIconPathsStuff>
  </ThingDef>

